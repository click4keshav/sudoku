    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "41512cd5-98b2-468b-ab64-58e1851b2143"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
